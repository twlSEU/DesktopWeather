<Window x:Class="DesktopWeather.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:rendering="clr-namespace:DesktopWeather.Rendering"
    Title="桌面天气 · Desktop Weather" Width="1040" Height="840" MinWidth="900" MinHeight="620"
    WindowStartupLocation="CenterScreen" Background="#0C1424" Foreground="#E6EDF6"
    FontFamily="Microsoft YaHei UI" FontSize="13" WindowStyle="None" ResizeMode="CanResize">
  <WindowChrome.WindowChrome><WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" /></WindowChrome.WindowChrome>
  <Border BorderBrush="#26374D" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid Background="#0B1220">
        <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="❄" FontFamily="Segoe UI Symbol" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,9,0" />
          <TextBlock Text="桌面天气" FontSize="12" />
          <TextBlock Text="DESKTOP WEATHER" FontFamily="Segoe UI" FontSize="10" Foreground="#5F7899" Margin="12,2,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
          <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeButtonClick" ToolTip="最小化" WindowChrome.IsHitTestVisibleInChrome="True" />
          <Button Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="CloseButtonClick" ToolTip="关闭设置面板" WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="26,20,26,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
          <StackPanel>
            <TextBlock Text="给桌面，添一点季节。" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="春樱、夏夜、夏雨、秋叶，还有冬日的雪。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
          </StackPanel>
          <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#17293A" CornerRadius="12" Padding="11,5">
            <TextBlock Text="鼠标自由穿透" Foreground="#97D0DB" FontSize="11" />
          </Border>
        </Grid>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="#111C2D" CornerRadius="16" BorderBrush="#213148" BorderThickness="1" Padding="20,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="选择季节与天气" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <RadioButton x:Name="PetalsChoice" GroupName="Weather" Style="{StaticResource WeatherTile}" IsChecked="{Binding Mode, Converter={StaticResource ModeConverter}, ConverterParameter=Petals, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="✿" FontFamily="Segoe UI Symbol" Foreground="#F9BDD6" FontSize="24" VerticalAlignment="Center" Margin="0,0,9,0" /><StackPanel><TextBlock Text="春 · 樱花" FontWeight="SemiBold" /><TextBlock Text="花瓣随风" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="FirefliesChoice" Grid.Column="2" GroupName="Weather" Style="{StaticResource WeatherTile}" IsChecked="{Binding Mode, Converter={StaticResource ModeConverter}, ConverterParameter=Fireflies, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="✦" FontFamily="Segoe UI Symbol" Foreground="#DAF69E" FontSize="24" VerticalAlignment="Center" Margin="0,0,9,0" /><StackPanel><TextBlock Text="夏 · 萤火" FontWeight="SemiBold" /><TextBlock Text="微光闪烁" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="RainChoice" Grid.Row="2" GroupName="Weather" Style="{StaticResource WeatherTile}" IsChecked="{Binding Mode, Converter={StaticResource ModeConverter}, ConverterParameter=Rain, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><Path Data="M 5,0 L 0,14 M 13,3 L 8,18 M 21,0 L 16,14" Stroke="#BCE5FA" StrokeThickness="2" Width="22" Height="24" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0" /><StackPanel><TextBlock Text="夏 · 细雨" FontWeight="SemiBold" /><TextBlock Text="清凉雨丝" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="LeavesChoice" Grid.Row="2" Grid.Column="2" GroupName="Weather" Style="{StaticResource WeatherTile}" IsChecked="{Binding Mode, Converter={StaticResource ModeConverter}, ConverterParameter=Leaves, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><Path Data="M 0,0 C 22,-2 26,17 3,24 C -7,14 -7,3 0,0 Z M 3,24 L 16,7" Fill="#DEAA59" Stroke="#AC773F" Width="22" Height="24" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0" /><StackPanel><TextBlock Text="秋 · 落叶" FontWeight="SemiBold" /><TextBlock Text="温暖悠然" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel></StackPanel>
                  </RadioButton>
                  <RadioButton x:Name="SnowChoice" Grid.Row="4" Grid.ColumnSpan="3" GroupName="Weather" Style="{StaticResource WeatherTile}" IsChecked="{Binding Mode, Converter={StaticResource ModeConverter}, ConverterParameter=Snow, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="❄" FontFamily="Segoe UI Symbol" Foreground="#AAEAF4" FontSize="24" VerticalAlignment="Center" Margin="0,0,9,0" /><StackPanel><TextBlock Text="冬 · 雪花" FontWeight="SemiBold" /><TextBlock Text="轻盈静谧" Style="{StaticResource MutedText}" FontSize="10" Margin="0,4,0,0" /></StackPanel></StackPanel>
                  </RadioButton>
                </Grid>
                <Grid Margin="0,14,0,0"><TextBlock Text="数量" /><TextBlock Text="{Binding Density, StringFormat={}{0:0} 颗}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" FontFamily="Segoe UI" /></Grid>
                <Slider x:Name="DensitySlider" Minimum="50" Maximum="1600" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Density, Mode=TwoWay}" ToolTip="所有屏幕上的总数量" />
                <Grid Margin="0,7,0,0"><TextBlock Text="大小" /><TextBlock Text="{Binding Size, StringFormat={}{0:0.0}}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" FontFamily="Segoe UI" /></Grid>
                <Slider Minimum="2" Maximum="16" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding Size, Mode=TwoWay}" />
                <Grid Margin="0,7,0,0"><TextBlock Text="运动速度" /><TextBlock Text="{Binding Speed, StringFormat={}{0:0}}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" FontFamily="Segoe UI" /></Grid>
                <Slider Minimum="15" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Speed, Mode=TwoWay}" />
                <Grid Margin="0,7,0,0"><TextBlock Text="风向 / 风力" /><TextBlock Text="{Binding Wind, StringFormat={}{0:+0;-0;0}}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" FontFamily="Segoe UI" /></Grid>
                <Slider Minimum="-100" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Wind, Mode=TwoWay}" />
                <Grid><TextBlock Text="← 向左" FontSize="10" Foreground="#7185A0" /><TextBlock Text="向右 →" FontSize="10" Foreground="#7185A0" HorizontalAlignment="Right" /></Grid>
                <Grid Margin="0,7,0,0"><TextBlock Text="不透明度" /><TextBlock Text="{Binding Opacity, StringFormat={}{0:0}%}" Foreground="{StaticResource Accent}" HorizontalAlignment="Right" FontFamily="Segoe UI" /></Grid>
                <Slider Minimum="20" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Opacity, Mode=TwoWay}" />
                <Border Height="1" Background="#26354B" Margin="0,12,0,4" />
                <CheckBox Content="显示在所有屏幕" IsChecked="{Binding AllMonitors}" />
                <CheckBox Content="节能模式（30 帧）" IsChecked="{Binding EnergySaving}" ToolTip="关闭时跟随屏幕刷新率，动画更流畅" />
                <CheckBox Content="关闭面板后留在托盘" IsChecked="{Binding MinimizeToTray}" />
                <TextBlock Text="设置会自动保存，下次打开继续使用。" FontSize="10" Foreground="#7185A0" Margin="0,8,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Border>
          <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border CornerRadius="16" BorderBrush="#263C54" BorderThickness="1" ClipToBounds="True">
              <Grid ClipToBounds="True" SizeChanged="PreviewFrameSizeChanged">
                <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#172D46" Offset="0" /><GradientStop Color="#0D1A2D" Offset="0.7" /><GradientStop Color="#193244" Offset="1" /></LinearGradientBrush></Grid.Background>
                <Ellipse Fill="#1D4A60" Width="260" Height="260" Opacity="0.22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-90,-70,0" IsHitTestVisible="False" />
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,22,0,0">
                  <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#7DE1ED" VerticalAlignment="Center" Margin="0,0,7,0" /><TextBlock Text="实时预览" FontSize="11" Foreground="#A3C5D9" /></StackPanel>
                </StackPanel>
                <TextBlock x:Name="FpsText" Text="测量中" FontFamily="Segoe UI" FontSize="11" Foreground="#7DE1ED" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,24,0" ToolTip="每秒动画更新次数" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0,20,30">
                  <TextBlock x:Name="PreviewTitle" Text="让雪，慢慢落下。" FontSize="27" FontWeight="Light" Foreground="#D5E9F3" HorizontalAlignment="Center" />
                  <TextBlock x:Name="PreviewSubtitle" Text="一场属于你桌面的小雪" FontSize="12" Foreground="#829FB8" HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
                <Viewbox VerticalAlignment="Bottom" Stretch="Fill" Height="155" Opacity="0.8" IsHitTestVisible="False">
                  <Canvas Width="600" Height="180">
                    <Path Data="M 0,120 L 95,75 L 180,117 L 305,40 L 410,95 L 505,64 L 600,110 L 600,180 L 0,180 Z" Fill="#203A50" />
                    <Path Data="M 0,145 L 110,108 L 245,146 L 377,92 L 510,136 L 600,113 L 600,180 L 0,180 Z" Fill="#142A3E" />
                    <Path Data="M 0,169 Q 135,131 270,161 Q 425,125 600,158 L 600,180 L 0,180 Z" Fill="#0F2133" />
                  </Canvas>
                </Viewbox>
                <rendering:ParticleSurface x:Name="PreviewSurface" />
                <Border VerticalAlignment="Bottom" Background="#990C1726" Padding="18,12">
                  <TextBlock Text="开启后，季节特效会显示在应用窗口上方，鼠标照常操作。" FontSize="11" Foreground="#9FB5CA" TextWrapping="Wrap" />
                </Border>
              </Grid>
            </Border>
            <Border Grid.Row="1" Background="#111C2D" CornerRadius="12" BorderBrush="#213148" BorderThickness="1" Padding="16,13" Margin="0,14,0,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="快速选择一种心情" Style="{StaticResource MutedText}" />
                <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                  <Button x:Name="SpringPreset" Content="春樱" Tag="Spring" Click="PresetButtonClick" Padding="14,7" Margin="0,0,8,4" />
                  <Button x:Name="SummerNightPreset" Content="夏夜" Tag="SummerNight" Click="PresetButtonClick" Padding="14,7" Margin="0,0,8,4" />
                  <Button x:Name="SummerRainPreset" Content="夏雨" Tag="SummerRain" Click="PresetButtonClick" Padding="14,7" Margin="0,0,8,4" />
                  <Button Content="秋风" Tag="Autumn" Click="PresetButtonClick" Padding="14,7" Margin="0,0,8,4" />
                  <Button Content="轻雪" Tag="SoftSnow" Click="PresetButtonClick" Padding="14,7" Margin="0,0,8,4" />
                  <Button Content="大雪" Tag="HeavySnow" Click="PresetButtonClick" Padding="14,7" Margin="0,0,0,4" />
                </WrapPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,20,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#62748D" VerticalAlignment="Center" Margin="0,0,9,0" /><TextBlock x:Name="StateTitle" Text="特效已停止" FontWeight="SemiBold" /></StackPanel>
            <TextBlock x:Name="StateDetail" Text="Ctrl + Alt + F12 可随时停止特效" Style="{StaticResource MutedText}" FontSize="10" Margin="16,6,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="退出软件" Click="ExitButtonClick" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Muted}" Padding="10,10" Margin="0,0,10,0" />
            <Button x:Name="PauseButton" Content="暂停" Click="PauseButtonClick" IsEnabled="False" MinWidth="72" Margin="0,0,10,0" />
            <Button x:Name="PrimaryButton" Content="开始下雪" Style="{StaticResource PrimaryButton}" Click="PrimaryButtonClick" MinWidth="126" />
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
