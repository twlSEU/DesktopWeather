<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>DesktopWeather</AssemblyName>
    <RootNamespace>DesktopWeather</RootNamespace>
    <Version>1.3.1</Version>
    <Company>DesktopWeather</Company>
    <Product>桌面天气</Product>
    <Description>可以自由调节的四季桌面特效：樱花、萤火虫、夏雨、落叶与雪花</Description>
    <DefaultItemExcludes>$(DefaultItemExcludes);.tools\**;release\**</DefaultItemExcludes>
    <!-- WPF owns DPI awareness via the manifest; WinForms is used only for tray/screens. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>
</Project>
